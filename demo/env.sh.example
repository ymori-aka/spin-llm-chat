# Copy to demo/env.sh, fill in the key, then `source demo/env.sh`.
# demo/env.sh is gitignored — never commit the real key.
#
# Two names for the same secret, because the two commands read it differently:
#   SPIN_VARIABLE_ZUPLO_API_KEY  →  picked up automatically by `spin up`
#   ZUPLO_KEY                    →  passed explicitly to `spin aka deploy --variable`
#                                   (that command ignores SPIN_VARIABLE_*)
KEY="zpka_..."

export SPIN_VARIABLE_ZUPLO_API_KEY="$KEY"
export ZUPLO_KEY="$KEY"
