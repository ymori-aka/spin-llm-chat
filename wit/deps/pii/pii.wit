// Contract for the PII guard. Implemented in Python (componentize-py).
package ymori:pii@0.1.0;

interface guard {
    record verdict {
        // True when the text must not be forwarded to the LLM.
        blocked: bool,
        // Human-readable explanation, shown in the chat UI when blocked.
        reason: string,
    }

    check: func(text: string) -> verdict;
}

